<!-- 
  演示变量使用:
    1.变量声明
    2.变量调用
    3.变量运算
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="demo02_property">
  <!-- 1.变量声明 -->
  <xacro:property name="num1" value="10"/>
  <xacro:property name="num2" value="20"/>
  <!-- 2.变量调用 -->
  <car lenght="${num1}" width="${num2}" />
  <!-- 3.变量运算 -->
  <car lenght="${num1 + num2}"/>
</robot>