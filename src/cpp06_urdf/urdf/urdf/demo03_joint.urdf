<!-- 
  需求:要创建一个机器人模型,由底盘和摄像头组成,摄像头可以沿着自身z轴旋转
  实现:
    1.创建base_link作为底盘
    2.创建camera摄像头
    3.通过joint关联底盘和摄像头
-->
<robot name="demo03_joint">

  <material name="yellow">
    <color rgba="0.8 0.6 0.2 0.5"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.0 0.0 0.5"/>
  </material>
 
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.5 0.3 0.1"/>
      </geometry>
      <material name="yellow"/>
    </visual>
  </link>

  <link name="camera">
    <visual>
      <geometry>
        <box size="0.02 0.05 0.05"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="camera2base_link" type="continuous">
    <parent link="base_link"/>
    <child link="camera"/>
    <!-- 设置平移量和旋转度 -->
    <origin xyz="0.2 0 0.075" rpy="0 0 0"/>
    <!-- 设置自由度 -->
    <axis xyz="0 0 1"/>
  </joint>

</robot>