  <!-- 添加传感器插件 -->
  <gazebo>
    <plugin
      filename="ignition-gazebo-sensors-system"
      name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine> <!-- 渲染方式 -->
    </plugin>
  </gazebo>
  <!-- 雷达传感器 -->
  <gazebo reference="laser"> <!-- 针对生效的link -->
    <sensor name='scan' type='gpu_lidar'>
      <topic>scan</topic> <!-- 单线 /scan 多线 /scan/points -->
      <update_rate>20</update_rate>
      <lidar>
        <scan>
          <!-- 水平采样参数 -->
          <horizontal>
            <samples>640</samples> <!-- 水平旋转一个周期采样点 -->
            <resolution>1</resolution> <!-- 雷达分辨率,前后扫描的间隔  单位 度-->
            <!-- 扫描角度 单位 弧度 -->
            <min_angle>-3.1415926</min_angle> <!-- 最小角度 -->
            <max_angle>3.1415926</max_angle> <!-- 最大角度 -->
          </horizontal>
          <!-- 垂直采样参数 -->
          <vertical>
            <samples>16</samples> <!-- 16 线 激光雷达 -->
            <resolution>1</resolution> 
            <min_angle>-0.261799</min_angle>
            <max_angle>0.261799</max_angle>
          </vertical>
        </scan>
        <range> <!-- 有效距离 -->
          <min>0.08</min>
          <max>10.0</max>
          <resolution>0.01</resolution> <!-- 扫描精度 米 -->
        </range>
      </lidar>
      <alwaysOn>1</alwaysOn> <!-- 是否一直打开 -->
      <visualize>true</visualize> <!-- 是否可见 -->
      <ignition_frame_id>laser</ignition_frame_id> <!-- 指定雷达消息使用的frame-id -->
    </sensor>
  </gazebo>

  <gazebo reference="camera"> <!-- 针对生效的link -->
    <sensor name="depth_camera" type="depth_camera">
          <ignition_frame_id>camera</ignition_frame_id>
          <update_rate>10</update_rate>
          <topic>/depth_camera</topic>
          <camera>
            <horizontal_fov>1.05</horizontal_fov>
            <image>
              <width>256</width>
              <height>256</height>
              <format>R_FLOAT32</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>10.0</far>
            </clip>
          </camera>
          <alwaysOn>1</alwaysOn>
      </sensor>
  </gazebo>

  <gazebo reference="camera">
    <sensor name="camera_link" type="camera">
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>320</width>
              <height>240</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
          <always_on>true</always_on>
          <update_rate>20</update_rate>
          <visualize>true</visualize>
          <topic>/image_raw</topic>
          <ignition_frame_id>camera</ignition_frame_id>
        </sensor>
  </gazebo>
  
</robot>
