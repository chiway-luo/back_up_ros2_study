<!-- install(DIRECTORY launch DESTINATION share/${PROJECT_NAME}) cmake配置 -->
<!-- <exec_depend>ros2launch</exec_depend> package.xml配置 -->
<!-- from glob import glob 用于setup.py配置多个launch文件 -->
<!-- ('share/' + package_name, glob('launch/*_launch.py')), -->
<!-- ('share/' + package_name, glob('launch/*_launch.xml')), -->
<!-- ('share/' + package_name, glob('launch/*_launch.yaml')), -->
<!-- 
  当前为教师示例代码
    需求: 实现乌龟护航案例
        先实现一只乌龟护航 ,要求最终位置处理turtle1的正后方2米
    思路:
        1.先发布目标点相对于turtle1的坐标系变换
        2.监听turtle2与目标点的相对位置关系
    流程:
        1.抽取参数
        2.创建turtlesim_node节点,并生成新乌龟
        3.发布坐标变换(turtle1->base_link,turtle2->base_link,目标点->turtle1)
        4.使用静态变换发布器发布目标点相对于turtle1的坐标系变换
        4.监听目标变换(turtle2->目标点),并发布速度指令
-->
<launch>
  <!-- 抽取参数 -->
  <arg name="turtle_name" default="turtle1" />
  <arg name="turtle_back" default="turtle_back" />
  <arg name="turtle_left" default="turtle_left" />
  <arg name="turtle_right" default="turtle_right" />

  <arg name="point_back" default="point_back" />
  <arg name="point_left" default="point_left" />
  <arg name="point_right" default="point_right" />

  <!-- 创建turtlesim_node节点,并生成新的乌龟 -->
  <node pkg="turtlesim" exec="turtlesim_node" name="turtle1" />

  <node pkg="py05_exercise" exec="exer01_spawn_py" name="spawn_turtle_back">
    <param name="turtle_name" value="$(var turtle_back)" />
    <param name="x" value="5.0" />
    <param name="y" value="3.0" />
    <param name="theta" value="0.0" />
  </node>
  <node pkg="py05_exercise" exec="exer01_spawn_py" name="spawn_turtle_left">
    <param name="turtle_name" value="$(var turtle_left)" />
    <param name="x" value="5.0" />
    <param name="y" value="3.0" />
    <param name="theta" value="0.0" />
  </node>
  <node pkg="py05_exercise" exec="exer01_spawn_py" name="spawn_turtle_right">
    <param name="turtle_name" value="$(var turtle_right)" />
    <param name="x" value="5.0" />
    <param name="y" value="3.0" />
    <param name="theta" value="0.0" />
  </node>
  <!-- 发布坐标变换节点 -->
  <node pkg="py05_exercise" exec="exer02_tf_broadcaster_py" name="tf_broadcaster_source" >
    <param name="frame_id" value="base_link" />
    <param name="child_frame_id" value="$(var turtle_name)" />
  </node>
  <node pkg="py05_exercise" exec="exer02_tf_broadcaster_py" name="tf_broadcaster_back" >
    <param name="frame_id" value="base_link" />
    <param name="child_frame_id" value="$(var turtle_back)" />
  </node>
  <node pkg="py05_exercise" exec="exer02_tf_broadcaster_py" name="tf_broadcaster_left" >
    <param name="frame_id" value="base_link" />
    <param name="child_frame_id" value="$(var turtle_left)" />
  </node>
  <node pkg="py05_exercise" exec="exer02_tf_broadcaster_py" name="tf_broadcaster_right" >
    <param name="frame_id" value="base_link" />
    <param name="child_frame_id" value="$(var turtle_right)" />
  </node>
  <!-- 静态坐标变换 -->
  <node pkg="tf2_ros" exec="static_transform_publisher" name="static_tf_back" 
      args="
      --frame-id $(var turtle_name)
      --child-frame-id $(var point_back)
      --x -1.0 
      "
  />
  <node pkg="tf2_ros" exec="static_transform_publisher" name="static_tf_left" 
      args="
      --frame-id $(var turtle_name) 
      --child-frame-id $(var point_left)
      --y 1.0 
      "
  />
  <node pkg="tf2_ros" exec="static_transform_publisher" name="static_tf_right" 
      args="
      --frame-id $(var turtle_name) 
      --child-frame-id $(var point_right)
      --y -1.0 
      "
  />
  <!-- 监听坐标变换并发布速度指令 -->
  <node pkg="py05_exercise" exec="exer03_tf_listener_py" name="tf_listener_back" respawn="true" >
    <param name="frame_id" value="$(var turtle_back)" />
    <param name="goal_frame" value="$(var point_back)" />
  </node>
  <node pkg="py05_exercise" exec="exer03_tf_listener_py" name="tf_listener_left" respawn="true" >
    <param name="frame_id" value="$(var turtle_left)" />
    <param name="goal_frame" value="$(var point_left)" />
  </node>
  <node pkg="py05_exercise" exec="exer03_tf_listener_py" name="tf_listener_right" respawn="true" >
    <param name="frame_id" value="$(var turtle_right)" />
    <param name="goal_frame" value="$(var point_right)" />
  </node>

</launch>


