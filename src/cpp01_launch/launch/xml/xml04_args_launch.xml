<launch>
  <!-- 需要启动turtlesim_node 节点时动态设置背景颜色 -->
  <!-- 声明参数 -->
  <arg name="rgb_r" default="0" />
  <arg name="rgb_g" default="0" />
  <arg name="rgb_b" default="0" />
  <!-- 调用参数  ros2 launch cpp01_launch xml04_args_launch.xml rgb_r:=255 rgb_g:=0 rgb_b:=0 -->
  <node pkg="turtlesim" exec="turtlesim_node">
    <param name="background_r" value="$(var rgb_r)" />
    <param name="background_g" value="$(var rgb_g)" />
    <param name="background_b" value="$(var rgb_b)" />
  </node>
  <!-- launch文件执行时动态传参 -->

</launch>