<launch>
  <!-- 演示node的使用 -->
  <node pkg="turtlesim" exec="turtlesim_node" name="sdy_turtle1" namespace="sdy_namespace1" exec_name="my_lable_sdy" respawn="True" />
  <!-- 方式一设置单个参数 -->
  <node pkg="turtlesim" exec="turtlesim_node" name="sdy_turtle1" namespace="sdy_namespace2" exec_name="my_lable_sdy" respawn="True" >
    <param name="background_r" value="0"/>
    <param name="background_g" value="0"/>
    <param name="background_b" value="0"/>
  </node>
  <!-- 方式二从yaml文件导入参数 -->
  <node pkg="turtlesim" exec="turtlesim_node" name="sdy_turtle1" namespace="sdy_namespace3" exec_name="my_lable_sdy" respawn="True" >
    <param from="$(find-pkg-share cpp01_launch)/config/sdy_turtle_turtlesim.yaml"  />
    <!-- /home/chiway/study_code/stu_ros2/ws02_tools/install/cpp01_launch/share/cpp01_launch/config/sdy_turtle__turtlesim.yaml -->
  </node>

  <!-- ros_args -->
  <node pkg="turtlesim" exec="turtlesim_node" respawn="True" ros_args="--remap __ns:/xx/yy" name="sdy_turtle1" />
  <!-- args -->
  <node pkg="turtlesim" exec="turtlesim_node" respawn="True" ros_args="--ros-args --remap __ns:/xx/yy" name="sdy_turtle1" />


</launch>